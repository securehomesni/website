# Copy to .env for `npm run dev` (build-time, public values only).
# Cloudflare Turnstile site key. The value below is Cloudflare's test key (always passes).
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Production domain, used for canonical URLs and the sitemap.
SITE_URL=https://www.example.co.uk
