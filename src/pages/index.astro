---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Services from '../components/home/Services.astro';
import SystemDemo from '../components/home/SystemDemo.astro';
import Bundle from '../components/home/Bundle.astro';
import Properties from '../components/home/Properties.astro';
import WhyChoose from '../components/home/WhyChoose.astro';
import Compare from '../components/home/Compare.astro';
import Process from '../components/home/Process.astro';
import DirectorQuote from '../components/home/DirectorQuote.astro';
import Areas from '../components/home/Areas.astro';
import FinalCta from '../components/home/FinalCta.astro';
import { site } from '../config/site';
---
<BaseLayout
  title={`CCTV, Alarm and Security Lighting Installers in Belfast | ${site.name}`}
  description="Local, SSAIB-registered CCTV, alarm and security lighting installers in Belfast and across Northern Ireland. Repairs, servicing and system takeovers too."
  businessSchema
>
  <Hero />
  <Services />
  <Properties />
  <SystemDemo />
  <Bundle />
  <WhyChoose />
  <Compare />
  <Process />
  <DirectorQuote />
  <Areas />
  <FinalCta />
</BaseLayout>
