---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CtaPanel from '../../components/CtaPanel.astro';
import { breadcrumbSchema, serviceSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const others = (await getCollection('services'))
  .filter((s) => s.id !== entry.id)
  .sort((a, b) => a.data.order - b.data.order);

const path = `/services/${entry.id}/`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services/' },
  { name: entry.data.title, path },
];
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
---
<BaseLayout
  title={entry.data.metaTitle}
  description={entry.data.metaDescription}
  schema={[
    breadcrumbSchema(crumbs, siteUrl),
    serviceSchema({ name: entry.data.title, description: entry.data.summary, path }, siteUrl),
  ]}
>
  <PageHeader title={entry.data.title} intro={entry.data.summary} breadcrumbs={crumbs} />
  <div class="wrap grid gap-12 py-section lg:grid-cols-12">
    <article class="prose-content lg:col-span-8">
      <Content />
    </article>
    <div class="space-y-10 lg:col-span-4">
      <div class="lg:sticky lg:top-[calc(var(--header-height)+2rem)]">
        <CtaPanel />
        <nav aria-labelledby="other-services" class="mt-10">
          <h2 id="other-services" class="text-lg">Other services</h2>
          <ul class="mt-3 space-y-1">
            {others.map((s) => (
              <li><a class="link inline-flex min-h-10 items-center" href={`/services/${s.id}/`}>{s.data.title}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </div>
  </div>
</BaseLayout>
