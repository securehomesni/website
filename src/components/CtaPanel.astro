---
/** Repeated call to action for inner pages (service, location and guide pages). */
import { site, ctaLabel, ctaHref } from '../config/site';
import Icon from './ui/Icon.astro';

interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Get a free quote',
  text = 'Call us, or request a call back. We’ll arrange a free survey of your home and send a fixed written quote, with no obligation.',
} = Astro.props;
---
<aside aria-labelledby="cta-panel-title" class="rounded-md border-t-4 border-teal bg-mint p-6 md:p-8">
  <h2 id="cta-panel-title" class="text-xl">{title}</h2>
  <p class="mt-3">{text}</p>
  <div class="mt-6 flex flex-col gap-3">
    <a href={site.phone.href} class="btn btn-primary">
      <Icon name="phone" />
      <span>Call {site.phone.display}</span>
    </a>
    <a href={ctaHref} class="btn btn-secondary">{ctaLabel}</a>
  </div>
</aside>
