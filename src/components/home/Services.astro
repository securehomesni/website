---
/**
 * Services: the three core services (featured: true in src/content/services/),
 * each with a photo, then the kinds of work we do on any system.
 *
 * PHOTOS: replace the files in src/assets/work/ with real photos of your work.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { servicesBase } from '../../config/site';
import type { ImageMetadata } from 'astro';
import workCctv from '../../assets/work/work-cctv.jpg';
import workAlarm from '../../assets/work/work-alarm.jpg';
import workLighting from '../../assets/work/work-lighting.jpg';

// Photo and alt text for each featured service, by file name in src/content/services/
const photos: Record<string, { src: ImageMetadata; alt: string }> = {
  cctv: { src: workCctv, alt: 'Placeholder: a dome camera fitted neatly under the eaves of a gable wall' },
  'intruder-alarms': { src: workAlarm, alt: 'Placeholder: an alarm keypad mounted beside a front door' },
  'security-lighting': { src: workLighting, alt: 'Placeholder: an LED security light above a driveway at dusk' },
};

const services = (await getCollection('services'))
  .filter((s) => s.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

// "CCTV installation" -> "CCTV installation", "Intruder alarms" -> "intruder alarms"
const lowerFirst = (t: string) => t.replace(/^\S+/, (w) => (w === w.toUpperCase() ? w : w.toLowerCase()));

const workTypes = [
  { title: 'New installations', text: 'Designed around your home after a free survey.' },
  { title: 'Repairs', text: 'Faults, false alarms and cameras that have stopped recording.' },
  { title: 'Upgrades', text: 'Add cameras or sensors, or replace an old system with a modern one.' },
  { title: 'Servicing', text: 'Regular checks that keep everything working and insurers happy.' },
  { title: 'System takeovers', text: 'We take over systems fitted by other companies, including ones that have stopped trading.' },
];
---
<section aria-labelledby="services-title" class="py-section">
  <div class="wrap">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <h2 id="services-title" class="text-3xl tracking-display lg:col-span-6">Home security services</h2>
      <p class="max-w-xl text-lg text-muted lg:col-span-6">
        Three systems that work best together. We fit them, fix them, upgrade them and look after them, and we take over systems other companies installed.
      </p>
    </div>

    <ul class="mt-12 grid gap-12 md:grid-cols-3 md:gap-8">
      {services.map((s) => {
        const photo = photos[s.id];
        return (
          <li class="flex flex-col">
            {photo && (
              <Image
                src={photo.src}
                alt={photo.alt}
                widths={[400, 640, 960]}
                sizes="(min-width: 76rem) 24rem, (min-width: 48rem) 31vw, 100vw"
                class="aspect-[4/3] w-full rounded-md object-cover"
                loading="lazy"
              />
            )}
            <h3 class="mt-6 border-t-2 border-navy pt-4 text-2xl tracking-display">
              <a href={`${servicesBase}/${s.id}/`} class="hover:text-teal-ink hover:underline hover:decoration-2 hover:underline-offset-4">
                {s.data.title}
              </a>
            </h3>
            <p class="mt-3">{s.data.summary}</p>
            <p class="mt-auto pt-4">
              <a href={`${servicesBase}/${s.id}/`} class="link font-semibold">More about {lowerFirst(s.data.title)}</a>
            </p>
          </li>
        );
      })}
    </ul>

    <div class="mt-16 rounded-md border border-line bg-white">
      <h3 class="border-b border-line px-6 py-4 text-lg">For every system, we do</h3>
      <ul class="grid gap-px bg-line sm:grid-cols-2 lg:grid-cols-5">
        {workTypes.map((w) => (
          <li class="bg-white px-6 py-5 sm:last:col-span-2 lg:last:col-span-1">
            <p class="font-semibold text-navy">{w.title}</p>
            <p class="mt-1 text-sm text-muted">{w.text}</p>
          </li>
        ))}
      </ul>
      <p class="rounded-b-md border-t border-line bg-mint px-6 py-4 text-sm">
        Need a repair, a service or a takeover? <a href={`${servicesBase}/maintenance/`} class="link font-semibold">Repairs, servicing and system takeovers</a>
      </p>
    </div>
  </div>
</section>
