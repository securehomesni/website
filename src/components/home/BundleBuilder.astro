---
/**
 * Bundle builder. Customers choose how many cameras, alarm sensors and lights they need
 * and see their bundle discount change as they go. No prices are shown.
 *
 * Settings: `bundle` in src/config/site.ts. Discount rules: src/lib/bundle.ts.
 *
 * It's an ordinary form that sends the choices to the call-back form on the contact page,
 * which pre-fills the message. So it still works if JavaScript fails: only the live
 * discount and the +/- buttons need it.
 */
import { site, ctaHref } from '../../config/site';
import { priceBundle } from '../../lib/bundle';
import Placeholder from '../ui/Placeholder.astro';

const { bundle } = site;
const start = { cameras: bundle.cameras.start, sensors: bundle.sensors.start, lights: bundle.lights.start };
const initial = priceBundle(start, bundle.discounts);

const options = [
  {
    key: 'cameras',
    interest: 'CCTV',
    title: 'CCTV cameras',
    text: 'Hikvision HD cameras with a recorder and phone viewing. Most homes need 2 to 4.',
    label: 'Number of cameras',
    one: 'camera',
    ...bundle.cameras,
  },
  {
    key: 'sensors',
    interest: 'Intruder alarm',
    title: 'Intruder alarm',
    text: 'A Pyronix alarm with door, window and motion sensors. A three-bedroom home usually needs 4 to 6.',
    label: 'Number of sensors',
    one: 'sensor',
    ...bundle.sensors,
  },
  {
    key: 'lights',
    interest: 'Security lighting',
    title: 'Security lighting',
    text: 'LED lights with motion sensors. Usually one for each outside door and one for the drive.',
    label: 'Number of lights',
    one: 'light',
    ...bundle.lights,
  },
];

const homeTypes = [
  'Terrace or townhouse',
  'Semi-detached house',
  'Detached house',
  'Bungalow',
  'Apartment or flat',
  'Rural home or farmhouse',
];
---
{bundle.show && (
  <section id="bundle" aria-labelledby="bundle-title" class="bg-mint py-section">
    <div class="wrap">
      <div class="max-w-2xl">
        <h2 id="bundle-title" class="text-3xl tracking-display">Build your security bundle</h2>
        <p class="mt-5 text-lg">
          Choose what your home needs. The more you combine, the bigger your discount. We’ll confirm the final price in a fixed written quote after a free survey.
        </p>
      </div>

      <form
        action={ctaHref}
        method="get"
        class="mt-12 grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-12"
        data-bundle
        data-discounts={JSON.stringify(bundle.discounts)}
      >
        <input type="hidden" name="interest" value="Security bundle" />

        <div class="space-y-4 lg:col-span-7">
          {options.map((o) => (
            <div class="rounded-md border border-line bg-white p-5 sm:p-6" role="group" aria-labelledby={`bundle-${o.key}-title`}>
              <label class="check items-start" for={`bundle-${o.key}-on`}>
                <input
                  type="checkbox"
                  id={`bundle-${o.key}-on`}
                  name="interest"
                  value={o.interest}
                  checked
                  class="mt-0.5"
                  data-include={o.key}
                />
                <span>
                  <span id={`bundle-${o.key}-title`} class="block text-lg font-semibold text-navy">{o.title}</span>
                  <span class="mt-0.5 block text-sm text-muted">{o.text}</span>
                </span>
              </label>

              <div class="mt-4 pl-[2.125rem]" data-amount={o.key}>
                <label class="block text-sm font-semibold text-navy" for={`bundle-${o.key}`}>{o.label}</label>
                <div class="mt-2 flex items-center gap-2">
                  <button type="button" class="btn btn-secondary size-11 min-h-11 p-0 text-xl" hidden data-step="-1" data-for={o.key} aria-label={`One fewer ${o.one}`}>−</button>
                  <input
                    class="field-input w-20 text-center text-lg font-semibold tabular-nums"
                    type="number"
                    inputmode="numeric"
                    id={`bundle-${o.key}`}
                    name={o.key}
                    min="1"
                    max={o.max}
                    value={o.start}
                    data-count={o.key}
                  />
                  <button type="button" class="btn btn-secondary size-11 min-h-11 p-0 text-xl" hidden data-step="1" data-for={o.key} aria-label={`One more ${o.one}`}>+</button>
                </div>
              </div>
            </div>
          ))}

          <div class="field rounded-md border border-line bg-white p-5 sm:p-6">
            <label class="field-label" for="bundle-home">Type of home (optional)</label>
            <select class="field-input" id="bundle-home" name="home">
              <option value="">Choose your type of home</option>
              {homeTypes.map((t) => <option>{t}</option>)}
            </select>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="rounded-md border-2 border-navy bg-white p-6 sm:p-8 lg:sticky lg:top-[calc(var(--header-height)+1.5rem)]">
            <h3 class="text-xl">Your bundle</h3>
            <div aria-live="polite" aria-atomic="true">
              <ul class="mt-4 space-y-2 border-b border-line pb-5" data-lines>
                {initial.lines.map((line) => <li class="flex gap-2"><span aria-hidden="true" class="text-teal-ink">✓</span>{line}</li>)}
              </ul>
              <p class="mt-5 flex items-baseline gap-3">
                <span class="text-[clamp(3.5rem,2.5rem+4vw,5rem)] font-bold leading-none tracking-display text-navy" data-percent>
                  {initial.percent}%
                </span>
                <span class="font-semibold text-navy">bundle discount</span>
              </p>
              <p class="mt-2 text-sm text-muted" data-reason>{initial.reason}</p>
              <p class="mt-3 rounded-sm bg-mint px-3 py-2 text-sm font-semibold text-navy" data-next hidden={!initial.nextStep}>{initial.nextStep}</p>
            </div>

            <button type="submit" class="btn btn-primary mt-6 w-full text-lg">Request a call back about this bundle</button>
            <p class="mt-3 text-center text-sm">
              or call <a class="link font-semibold" href={site.phone.href}>{site.phone.display}</a>
            </p>
            <p class="mt-5 text-xs text-muted"><Placeholder note="Bundle terms">{bundle.terms}</Placeholder></p>
          </div>
        </div>
      </form>
    </div>
  </section>
)}

<script>
  import { priceBundle, type BundleChoice, type BundleDiscounts } from '../../lib/bundle';

  const form = document.querySelector<HTMLFormElement>('[data-bundle]');

  if (form) {
    const discounts = JSON.parse(form.dataset.discounts ?? '{}') as BundleDiscounts;
    const keys = ['cameras', 'sensors', 'lights'] as const;
    const lines = form.querySelector<HTMLUListElement>('[data-lines]')!;
    const percent = form.querySelector<HTMLElement>('[data-percent]')!;
    const reason = form.querySelector<HTMLElement>('[data-reason]')!;
    const next = form.querySelector<HTMLElement>('[data-next]')!;

    const input = (key: string) => form.querySelector<HTMLInputElement>(`[data-count="${key}"]`)!;
    const included = (key: string) => form.querySelector<HTMLInputElement>(`[data-include="${key}"]`)!.checked;

    const clamp = (el: HTMLInputElement) => {
      const n = Math.round(Number(el.value));
      const max = Number(el.max);
      el.value = String(Number.isFinite(n) ? Math.min(Math.max(n, 1), max) : 1);
    };

    const update = () => {
      const choice = {} as BundleChoice;
      for (const key of keys) {
        const on = included(key);
        const el = input(key);
        // A disabled field isn't sent with the form, so left-out services stay out of the request
        el.disabled = !on;
        form.querySelectorAll<HTMLButtonElement>(`[data-for="${key}"]`).forEach((b) => {
          b.disabled = !on;
          b.hidden = false;
        });
        form.querySelector<HTMLElement>(`[data-amount="${key}"]`)!.classList.toggle('opacity-50', !on);
        choice[key] = on ? Number(el.value) || 0 : 0;
      }

      const result = priceBundle(choice, discounts);
      lines.replaceChildren(
        ...(result.lines.length ? result.lines : ['Nothing chosen yet']).map((text) => {
          const li = document.createElement('li');
          li.className = 'flex gap-2';
          if (result.lines.length) {
            const tick = document.createElement('span');
            tick.className = 'text-teal-ink';
            tick.setAttribute('aria-hidden', 'true');
            tick.textContent = '✓';
            li.append(tick);
          }
          li.append(text);
          return li;
        }),
      );
      percent.textContent = `${result.percent}%`;
      reason.textContent = result.reason || 'No bundle discount yet';
      next.textContent = result.nextStep;
      next.hidden = !result.nextStep;
    };

    form.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-step]');
      if (!button) return;
      const el = input(button.dataset.for!);
      el.value = String(Number(el.value) + Number(button.dataset.step));
      clamp(el);
      update();
    });
    form.addEventListener('change', (event) => {
      const target = event.target as HTMLInputElement;
      if (target.dataset.count) clamp(target);
      update();
    });
    form.addEventListener('input', update);

    update();
  }
</script>
