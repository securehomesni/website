---
/**
 * Christmas effects for the homepage hero: gentle snowfall, and a Secure Home NI
 * sleigh that flies across now and then.
 * Dates and on/off switch: `christmas` in src/config/site.ts.
 *
 * Accessibility:
 * - Never runs for people who have asked their device to reduce motion.
 * - A visible button pauses and restarts everything (WCAG 2.2.2), and the choice is remembered.
 * - It sits behind the text, is hidden from screen readers and can't be clicked.
 * - It stops when the hero is scrolled out of view or the tab is in the background.
 */
import { site } from '../../config/site';
const { christmas } = site;
---
{christmas.show && (
  <>
    <canvas
      class="pointer-events-none absolute inset-0 -z-5 h-full w-full"
      aria-hidden="true"
      hidden
      data-snow
      data-from={christmas.from}
      data-until={christmas.until}
    ></canvas>

    <!-- The sleigh. Original artwork: edit colours and wording here. -->
    <div class="pointer-events-none absolute top-[5%] left-0 -z-5 w-[170px] will-change-transform sm:w-[240px]" aria-hidden="true" hidden data-sleigh>
      <svg viewBox="0 0 320 110" class="block w-full overflow-visible" focusable="false">
        <defs>
          <g id="reindeer" fill="#f8f7f3" stroke="#f8f7f3" stroke-linecap="round">
            <ellipse cx="28" cy="30" rx="20" ry="8" stroke="none" />
            <path d="M44 26 52 12l8-2 2 4-7 3-5 13Z" stroke="none" />
            <path d="M53 11 50 2m1 4-4-2m9 6 1-9m0 4 4-2" fill="none" stroke-width="1.8" />
            <path d="M42 34 54 44m-14-9 10 11M14 34 2 42m15-7L6 46M10 27l-5-3" fill="none" stroke-width="3" />
          </g>
        </defs>
        <!-- reins -->
        <path d="M118 52Q160 44 220 44L295 38" fill="none" stroke="#7fd6cf" stroke-width="1.5" />
        <use href="#reindeer" x="170" y="22" />
        <use href="#reindeer" x="245" y="16" />
        <!-- sack of presents -->
        <ellipse cx="50" cy="56" rx="18" ry="16" fill="#9b7653" />
        <path d="M44 41q6 4 12 0" fill="none" stroke="#6e5238" stroke-width="2" />
        <!-- Santa -->
        <ellipse cx="96" cy="58" rx="16" ry="16" fill="#c8352b" />
        <rect x="80" y="59" width="32" height="4" fill="#142d4e" />
        <circle cx="100" cy="34" r="8" fill="#f1c9a5" />
        <path d="M92 36q8 16 16 0Z" fill="#fff" />
        <path d="M92 31q8-13 20-7l-4 7Z" fill="#c8352b" />
        <rect x="91" y="29" width="18" height="4" rx="2" fill="#fff" />
        <circle cx="113" cy="25" r="3" fill="#fff" />
        <path d="M106 54 118 52" stroke="#c8352b" stroke-width="5" stroke-linecap="round" />
        <!-- sleigh -->
        <path d="M14 40q-6 0-4 8l10 38h112q20-2 26-26l-12 2q-6 8-18 8H36l-2-24q-2-6-8-6Z" fill="#168c86" />
        <text x="84" y="82" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" font-weight="700" letter-spacing="0.4" fill="#fff">SECURE HOME NI</text>
        <path d="M8 92q-4 6 6 8h126q16 0 18-12M40 86v14m78-14v14" fill="none" stroke="#7fd6cf" stroke-width="3" stroke-linecap="round" />
      </svg>
    </div>

    <button
      type="button"
      class="absolute right-4 bottom-4 inline-flex min-h-11 items-center gap-2 rounded-sm border border-paper/40 bg-navy/60 px-3 text-sm font-semibold text-white hover:border-paper/80 sm:right-6 sm:bottom-6"
      hidden
      data-snow-toggle
    >
      <svg class="size-4" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M12 3v18M4.2 7.5l15.6 9M4.2 16.5l15.6-9" />
      </svg>
      <span data-snow-label>Pause animation</span>
    </button>
  </>
)}

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-snow]');
  const sleigh = document.querySelector<HTMLElement>('[data-sleigh]');
  const button = document.querySelector<HTMLButtonElement>('[data-snow-toggle]');
  const label = button?.querySelector<HTMLElement>('[data-snow-label]');

  // Is today inside the from/until window? Handles a window that crosses New Year.
  const inSeason = (from: string, until: string) => {
    const now = new Date();
    const today = `${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
    return from <= until ? today >= from && today <= until : today >= from || today <= until;
  };

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const ctx = canvas?.getContext('2d');

  if (
    canvas && sleigh && button && label && ctx &&
    inSeason(canvas.dataset.from ?? '12-01', canvas.dataset.until ?? '01-06') &&
    !reduceMotion.matches
  ) {
    const STORAGE_KEY = 'christmas-paused';
    const readPaused = () => {
      try { return localStorage.getItem(STORAGE_KEY) === '1'; } catch { return false; }
    };
    const savePaused = (value: boolean) => {
      try { localStorage.setItem(STORAGE_KEY, value ? '1' : '0'); } catch { /* storage blocked: still works for this visit */ }
    };

    /* ---- Snow --------------------------------------------------------- */
    type Flake = { x: number; y: number; r: number; speed: number; drift: number; phase: number; alpha: number };
    let flakes: Flake[] = [];
    let width = 0;
    let height = 0;
    let frame = 0;
    let paused = readPaused();
    let visible = true;

    const makeFlake = (anywhere: boolean): Flake => ({
      x: Math.random() * width,
      y: anywhere ? Math.random() * height : -5,
      r: 0.8 + Math.random() * 2.2,
      speed: 0.25 + Math.random() * 0.7,
      drift: 0.3 + Math.random() * 0.6,
      phase: Math.random() * Math.PI * 2,
      alpha: 0.35 + Math.random() * 0.45,
    });

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = canvas.clientWidth;
      height = canvas.clientHeight;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const count = Math.min(90, Math.round(width / 16));
      flakes = Array.from({ length: count }, () => makeFlake(true));
    };

    const draw = () => {
      ctx.clearRect(0, 0, width, height);
      for (const f of flakes) {
        f.phase += 0.01;
        f.y += f.speed;
        f.x += Math.sin(f.phase) * f.drift * 0.4;
        if (f.y > height + 5) Object.assign(f, makeFlake(false));
        ctx.beginPath();
        ctx.arc(f.x, f.y, f.r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(255, 255, 255, ${f.alpha})`;
        ctx.fill();
      }
    };

    const loop = () => {
      draw();
      frame = requestAnimationFrame(loop);
    };

    /* ---- Sleigh: crosses in 14 seconds, then waits, every 40 seconds -- */
    const CYCLE = 40000;
    const CROSSING = 14000;
    let flight: Animation | null = null;

    const buildFlight = () => {
      const keep = flight?.currentTime ?? null;
      flight?.cancel();
      const span = (sleigh.parentElement?.clientWidth ?? window.innerWidth) + 40;
      const own = sleigh.offsetWidth || 240;
      const o = CROSSING / CYCLE;
      flight = sleigh.animate(
        [
          { transform: `translate(${-own - 20}px, 0)`, offset: 0 },
          { transform: `translate(${span * 0.25}px, -14px)`, offset: o * 0.25 },
          { transform: `translate(${span * 0.5}px, 6px)`, offset: o * 0.5 },
          { transform: `translate(${span * 0.75}px, -10px)`, offset: o * 0.75 },
          { transform: `translate(${span}px, -4px)`, offset: o },
          { transform: `translate(${span}px, -4px)`, offset: 1 },
        ],
        { duration: CYCLE, iterations: Infinity, delay: 2500 },
      );
      if (keep !== null) flight.currentTime = keep;
    };

    /* ---- Shared controls --------------------------------------------- */
    const update = () => {
      cancelAnimationFrame(frame);
      const running = !paused && visible && !document.hidden && !reduceMotion.matches;
      canvas.hidden = paused || reduceMotion.matches;
      sleigh.hidden = canvas.hidden;
      // The canvas has no size while hidden, so measure it again when it's first shown
      if (!canvas.hidden && canvas.clientWidth !== width) resize();
      if (!sleigh.hidden && !flight) buildFlight();
      if (running) {
        frame = requestAnimationFrame(loop);
        flight?.play();
      } else {
        flight?.pause();
      }
      label.textContent = paused ? 'Play animation' : 'Pause animation';
    };

    canvas.hidden = false;
    sleigh.hidden = false;
    button.hidden = false;
    resize();
    update();

    button.addEventListener('click', () => {
      paused = !paused;
      savePaused(paused);
      update();
    });

    // Stop when the hero is off screen or the tab is in the background
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      update();
    }).observe(canvas.parentElement ?? canvas);
    document.addEventListener('visibilitychange', update);
    reduceMotion.addEventListener('change', () => {
      if (reduceMotion.matches) button.hidden = true;
      update();
    });

    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        resize();
        if (flight) buildFlight();
        update();
      }, 200);
    });
  }
</script>
