---
/**
 * Interactive demo: CCTV, alarm and security lighting working together, controlled from the app.
 * Visitors pick day or night, then try a scenario and watch the house and the app respond.
 *
 * Everything is shown in text in the app panel too (its activity list is announced to
 * screen readers), so the house illustration is decorative.
 * Wording of the activity messages is in the script at the bottom.
 */
interface Props {
  title?: string;
}
const { title = 'See how it all works together' } = Astro.props;
---
<section aria-labelledby="demo-title" class="border-y border-line bg-white py-section">
  <div class="wrap">
    <div class="max-w-2xl">
      <h2 id="demo-title" class="text-3xl tracking-display">{title}</h2>
      <p class="mt-5 text-lg">
        Your cameras, alarm and lights work as one system, and you control it all from your phone.
        Pick day or night, then see what happens when someone comes to the house.
      </p>
    </div>

    <div
      class="group mt-12 grid gap-10 lg:grid-cols-12 lg:gap-12"
      data-demo
      data-time="day"
      data-light="off"
      data-rec="off"
      data-alarm="off"
      data-armed="off"
      data-person="none"
    >
      <!-- Controls and house -->
      <div class="lg:col-span-7">
        <div class="flex flex-col gap-5 sm:flex-row sm:flex-wrap sm:items-end sm:justify-between">
          <div>
            <p class="text-sm font-semibold text-navy" id="demo-time-label">Time of day</p>
            <div class="mt-2 inline-flex rounded-sm border border-line-strong p-1" role="group" aria-labelledby="demo-time-label">
              <button type="button" class="min-h-10 rounded-sm px-4 font-semibold text-navy aria-pressed:bg-navy aria-pressed:text-white" aria-pressed="true" data-time-btn="day">Day</button>
              <button type="button" class="min-h-10 rounded-sm px-4 font-semibold text-navy aria-pressed:bg-navy aria-pressed:text-white" aria-pressed="false" data-time-btn="night">Night</button>
            </div>
          </div>
          <button type="button" class="link min-h-10 self-start text-sm font-semibold sm:self-end" data-act="reset">Start again</button>
        </div>

        <!-- Decorative: the app panel describes everything in words -->
        <svg viewBox="0 0 480 330" class="mt-6 block w-full rounded-md border border-line" aria-hidden="true" focusable="false">
          <rect width="480" height="330" class="fill-[#cfe6f2] transition-colors duration-700 group-data-[time=night]:fill-[#16243a] motion-reduce:transition-none" />
          <circle cx="420" cy="55" r="22" class="fill-[#f6c945] transition-opacity duration-700 group-data-[time=night]:opacity-0 motion-reduce:transition-none" />
          <g class="opacity-0 transition-opacity duration-700 group-data-[time=night]:opacity-100 motion-reduce:transition-none">
            <circle cx="420" cy="55" r="18" fill="#f1eedd" />
            <circle cx="412" cy="49" r="17" fill="#16243a" />
            <circle cx="60" cy="40" r="1.5" fill="#fff" /><circle cx="140" cy="25" r="1.2" fill="#fff" />
            <circle cx="330" cy="30" r="1.4" fill="#fff" /><circle cx="250" cy="45" r="1" fill="#fff" />
          </g>
          <rect y="280" width="480" height="50" class="fill-[#a9cfa4] transition-colors duration-700 group-data-[time=night]:fill-[#2c4a3a] motion-reduce:transition-none" />
          <path d="M210 280h40l30 50h-100Z" class="fill-[#d9d4c7] transition-colors duration-700 group-data-[time=night]:fill-[#4b4f55] motion-reduce:transition-none" />

          <!-- house -->
          <rect x="100" y="140" width="260" height="140" class="fill-[#f3ede2] transition-colors duration-700 group-data-[time=night]:fill-[#b9b3a8] motion-reduce:transition-none" />
          <path d="M88 142 230 62l142 80Z" fill="#142d4e" />
          <rect x="125" y="175" width="55" height="45" class="fill-[#bcd8ea] transition-colors duration-700 group-data-[time=night]:fill-[#f2d98b] motion-reduce:transition-none" />
          <rect x="280" y="175" width="55" height="45" class="fill-[#bcd8ea] transition-colors duration-700 group-data-[time=night]:fill-[#f2d98b] motion-reduce:transition-none" />
          <path d="M152 175v45M125 197h55M307 175v45M280 197h55" stroke="#f3ede2" stroke-width="3" />
          <rect x="210" y="205" width="40" height="75" fill="#168c86" />
          <circle cx="242" cy="244" r="2.5" fill="#f8f7f3" />

          <!-- security light and its beam -->
          <path d="M230 199 150 300h160Z" fill="#ffe58a" class="opacity-0 transition-opacity duration-300 group-data-[light=on]:opacity-50 motion-reduce:transition-none" />
          <rect x="221" y="190" width="18" height="8" rx="2" fill="#29343d" />

          <!-- alarm bell box, with rings when sounding (static, never flashing) -->
          <rect x="112" y="148" width="20" height="24" rx="3" fill="#fff" stroke="#29343d" stroke-width="1.5" />
          <rect x="112" y="156" width="20" height="5" fill="#168c86" />
          <g fill="none" stroke="#b42318" stroke-width="3" stroke-linecap="round" class="opacity-0 group-data-[alarm=on]:opacity-100">
            <path d="M104 150q-8 10 0 20M96 145q-13 15 0 30M140 150q8 10 0 20M148 145q13 15 0 30" />
          </g>

          <!-- camera, with a recording badge -->
          <path d="M346 148v-6" stroke="#29343d" stroke-width="3" />
          <rect x="322" y="146" width="28" height="12" rx="3" fill="#fff" stroke="#29343d" stroke-width="1.5" />
          <circle cx="324" cy="152" r="3.5" fill="#29343d" />
          <g class="opacity-0 group-data-[rec=on]:opacity-100">
            <rect x="356" y="118" width="46" height="18" rx="9" fill="#b42318" />
            <circle cx="367" cy="127" r="3.5" fill="#fff" />
            <text x="390" y="131" text-anchor="middle" font-size="11" font-weight="700" fill="#fff" font-family="ui-sans-serif, system-ui, sans-serif">REC</text>
          </g>

          <!-- visitors -->
          <g fill="#1f2a33" class="opacity-0 transition-opacity duration-500 group-data-[person=door]:opacity-100 motion-reduce:transition-none">
            <circle cx="272" cy="226" r="9" />
            <path d="M260 240q12-8 24 0l4 40h-32Z" />
          </g>
          <g fill="#1f2a33" class="opacity-0 transition-opacity duration-500 group-data-[person=window]:opacity-100 motion-reduce:transition-none">
            <circle cx="318" cy="226" r="9" />
            <path d="M306 240q12-8 24 0l4 40h-32Z" />
            <path d="M326 244 334 216" stroke="#1f2a33" stroke-width="5" stroke-linecap="round" />
          </g>
        </svg>

        <div class="mt-6">
          <p class="text-sm font-semibold text-navy">Try it</p>
          <div class="mt-2 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <button type="button" class="btn btn-secondary whitespace-normal text-center" data-act="door">Someone comes to the front door</button>
            <button type="button" class="btn btn-secondary whitespace-normal text-center" data-act="window">Someone tries a window</button>
          </div>
          <p class="mt-3 text-sm text-muted">Tip: set the alarm in the app first, then try the window at night.</p>
        </div>
      </div>

      <!-- The app -->
      <div class="lg:col-span-5">
        <div class="mx-auto w-full max-w-[22rem] rounded-[2.25rem] border-[10px] border-navy bg-paper">
          <div class="px-4 pt-5 pb-6">
            <p class="text-center text-xs text-muted">Your security app</p>
            <p class="mt-1 text-center text-lg font-bold text-navy">My home</p>

            <div class="mt-4 space-y-3">
              <div class="rounded-md border border-line bg-white p-4 group-data-[alarm=on]:border-2 group-data-[alarm=on]:border-error group-data-[alarm=on]:bg-error-tint">
                <div class="flex items-center justify-between gap-3">
                  <div>
                    <p class="font-semibold text-navy">Alarm</p>
                    <p class="text-sm text-muted group-data-[alarm=on]:font-semibold group-data-[alarm=on]:text-error" data-alarm-status>Unset</p>
                  </div>
                  <button type="button" class="btn btn-primary min-h-10 px-3 py-1.5 text-sm" data-act="arm">Set alarm</button>
                </div>
              </div>

              <div class="rounded-md border border-line bg-white p-4">
                <div class="flex items-center justify-between gap-3">
                  <p class="font-semibold text-navy">Front camera</p>
                  <p class="text-sm text-muted group-data-[rec=on]:font-semibold group-data-[rec=on]:text-error" data-cam-status>Watching</p>
                </div>
                <svg viewBox="0 0 160 80" class="mt-3 block w-full rounded-sm" aria-hidden="true" focusable="false">
                  <rect width="160" height="80" class="fill-[#5d7486] group-data-[time=night]:fill-[#2a3540]" />
                  <rect x="60" y="18" width="30" height="62" fill="#168c86" class="group-data-[time=night]:fill-[#0f5d59]" />
                  <path d="M75 0 20 80h110Z" fill="#ffe58a" class="opacity-0 group-data-[light=on]:opacity-30" />
                  <g fill="#10171d" class="opacity-0 group-data-[person=door]:opacity-100">
                    <circle cx="108" cy="38" r="8" /><path d="M96 52q12-8 24 0l3 28H93Z" />
                  </g>
                  <g fill="#10171d" class="opacity-0 group-data-[person=window]:opacity-100">
                    <circle cx="140" cy="40" r="7" /><path d="M130 52q10-7 20 0l3 28h-26Z" />
                  </g>
                  <text x="8" y="14" font-size="9" font-weight="700" fill="#fff" font-family="ui-sans-serif, system-ui, sans-serif">LIVE</text>
                </svg>
              </div>

              <div class="rounded-md border border-line bg-white p-4">
                <div class="flex items-center justify-between gap-3">
                  <div>
                    <p class="font-semibold text-navy">Driveway light</p>
                    <p class="text-sm text-muted" data-light-status>Off</p>
                  </div>
                  <button type="button" class="btn btn-secondary min-h-10 px-3 py-1.5 text-sm" data-act="light">Turn on</button>
                </div>
              </div>

              <div class="pt-1">
                <p class="text-sm font-semibold text-navy" id="demo-activity">Activity</p>
                <ol class="mt-2 space-y-2 text-sm" aria-labelledby="demo-activity" aria-live="polite" data-log>
                  <li class="text-muted" data-empty>Nothing yet. Try one of the buttons.</li>
                </ol>
              </div>
            </div>
          </div>
        </div>
        <p class="mt-4 text-center text-sm text-muted">An illustration. The app you use depends on the equipment we fit.</p>
      </div>
    </div>
  </div>
</section>

<script>
  type Person = 'none' | 'door' | 'window';

  const root = document.querySelector<HTMLElement>('[data-demo]');

  if (root) {
    const q = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const log = q<HTMLOListElement>('[data-log]');
    const armBtn = q<HTMLButtonElement>('[data-act="arm"]');
    const lightBtn = q<HTMLButtonElement>('[data-act="light"]');
    const alarmStatus = q<HTMLElement>('[data-alarm-status]');
    const camStatus = q<HTMLElement>('[data-cam-status]');
    const lightStatus = q<HTMLElement>('[data-light-status]');
    const timeBtns = root.querySelectorAll<HTMLButtonElement>('[data-time-btn]');
    const emptyMessage = log.innerHTML;

    const initial = () => ({
      night: false,
      armed: false,
      alarm: false,
      light: false,
      autoLight: false, // switched on by motion, so it switches itself off again
      rec: false,
      person: 'none' as Person,
    });
    let state = initial();
    let timers: number[] = [];
    let minutes = 0;

    const later = (ms: number, fn: () => void) => timers.push(window.setTimeout(fn, ms));

    const clock = () => {
      // A believable time for the activity list: afternoon by day, late evening by night
      const start = state.night ? 22 * 60 + 14 : 14 * 60 + 5;
      const t = start + minutes++;
      return `${String(Math.floor(t / 60) % 24).padStart(2, '0')}:${String(t % 60).padStart(2, '0')}`;
    };

    const addLog = (text: string, urgent = false) => {
      log.querySelector('[data-empty]')?.remove();
      const li = document.createElement('li');
      li.className = urgent ? 'font-semibold text-error' : 'text-ink';
      const time = document.createElement('span');
      time.className = 'mr-2 tabular-nums text-muted';
      time.textContent = clock();
      li.append(time, ' ', text);
      log.prepend(li);
      while (log.children.length > 5) log.lastElementChild?.remove();
    };

    const render = () => {
      root.dataset.time = state.night ? 'night' : 'day';
      root.dataset.light = state.light ? 'on' : 'off';
      root.dataset.rec = state.rec ? 'on' : 'off';
      root.dataset.alarm = state.alarm ? 'on' : 'off';
      root.dataset.armed = state.armed ? 'on' : 'off';
      root.dataset.person = state.person;

      alarmStatus.textContent = state.alarm ? 'Sounding: window sensor' : state.armed ? 'Set' : 'Unset';
      armBtn.textContent = state.alarm ? 'Silence and unset' : state.armed ? 'Unset alarm' : 'Set alarm';
      camStatus.textContent = state.rec ? 'Recording' : 'Watching';
      lightStatus.textContent = state.light ? (state.autoLight ? 'On, by motion' : 'On') : 'Off';
      lightBtn.textContent = state.light ? 'Turn off' : 'Turn on';
      timeBtns.forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.timeBtn === 'night') === state.night)));
    };

    const lightOnByMotion = () => {
      if (state.night && !state.light) {
        state.light = true;
        state.autoLight = true;
        addLog('Driveway light switched on by motion.');
      }
    };

    const lightOffIfAuto = () => {
      if (state.autoLight && !state.alarm) {
        state.light = false;
        state.autoLight = false;
        addLog('Driveway light switched off.');
      }
    };

    const visitorLeaves = (ms: number) =>
      later(ms, () => {
        state.person = 'none';
        state.rec = false;
        lightOffIfAuto();
        render();
      });

    const actions: Record<string, () => void> = {
      door() {
        state.person = 'door';
        state.rec = true;
        addLog('Front camera: person at your front door. Clip saved.');
        lightOnByMotion();
        visitorLeaves(6000);
      },
      window() {
        state.person = 'window';
        state.rec = true;
        addLog('Front camera: person at the side of the house. Clip saved.');
        lightOnByMotion();
        if (state.armed) {
          state.alarm = true;
          if (state.night) state.light = true;
          addLog('Alarm sounding: window sensor triggered.', true);
          later(2500, () => addLog('Front camera: person has left. Clip saved.'));
          visitorLeaves(2500);
        } else {
          addLog('Window opened while the alarm was unset.');
          visitorLeaves(6000);
        }
      },
      arm() {
        if (state.alarm) {
          state.alarm = false;
          state.armed = false;
          addLog('Alarm silenced and unset from the app.');
          lightOffIfAuto();
        } else {
          state.armed = !state.armed;
          addLog(state.armed ? 'Alarm set from the app.' : 'Alarm unset from the app.');
        }
      },
      light() {
        state.light = !state.light;
        state.autoLight = false;
        addLog(state.light ? 'Driveway light switched on from the app.' : 'Driveway light switched off from the app.');
      },
      reset() {
        timers.forEach(clearTimeout);
        timers = [];
        const night = state.night;
        state = { ...initial(), night };
        minutes = 0;
        log.innerHTML = emptyMessage;
      },
    };

    root.addEventListener('click', (event) => {
      const target = (event.target as HTMLElement).closest<HTMLButtonElement>('button');
      if (!target) return;
      if (target.dataset.timeBtn) {
        state.night = target.dataset.timeBtn === 'night';
        if (!state.night && state.autoLight) {
          state.light = false;
          state.autoLight = false;
        }
      } else if (target.dataset.act) {
        actions[target.dataset.act]?.();
      }
      render();
    });

    render();
  }
</script>
