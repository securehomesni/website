---
/**
 * Our process. One process whether it's a new system, a repair, an upgrade
 * or servicing, so it's an ordered list with step numbers.
 */
import { ctaLabel, ctaHref, site } from '../../config/site';
import Placeholder from '../ui/Placeholder.astro';
---
<section aria-labelledby="process-title" class="py-section">
  <div class="wrap">
    <div class="max-w-2xl">
      <h2 id="process-title" class="text-3xl tracking-display">Our process</h2>
      <p class="mt-5 text-lg">
        Installation is only part of what we do. Whether it’s a new system, a repair, an upgrade, servicing or taking over a system someone else fitted, it works the same way, and you deal with the same local team throughout.
      </p>
    </div>

    <ol class="mt-14 grid gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <li class="border-t-2 border-navy pt-5">
        <p class="text-sm font-semibold text-teal-ink">Step 1</p>
        <h3 class="mt-1 text-xl">We visit and take a look</h3>
        <p class="mt-3">
          For a new system, a free survey of your home. For a repair, upgrade or takeover, we check your existing system and tell you what it needs.
          <Placeholder note="Confirm whether repair visits are charged">We’ll tell you any call-out charge before we come.</Placeholder>
        </p>
      </li>
      <li class="border-t-2 border-navy pt-5">
        <p class="text-sm font-semibold text-teal-ink">Step 2</p>
        <h3 class="mt-1 text-xl">You get a fixed quote</h3>
        <p class="mt-3">
          A written quote <Placeholder note="Quote turnaround">within two working days</Placeholder>, setting out exactly what we’ll do and the price.
        </p>
      </li>
      <li class="border-t-2 border-navy pt-5">
        <p class="text-sm font-semibold text-teal-ink">Step 3</p>
        <h3 class="mt-1 text-xl">We do the work</h3>
        <p class="mt-3">
          We install, repair or upgrade, test everything, tidy up and show you how it all works, including the app on your phone.
        </p>
      </li>
      <li class="border-t-2 border-navy pt-5">
        <p class="text-sm font-semibold text-teal-ink">Step 4</p>
        <h3 class="mt-1 text-xl">We keep it working</h3>
        <p class="mt-3">
          A 12-month guarantee, help on the phone when you need it, and optional servicing visits.
        </p>
      </li>
    </ol>

    <div class="mt-14 flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-6">
      <a href={ctaHref} class="btn btn-primary">{ctaLabel}</a>
      <p class="text-muted">
        Or call <a href={site.phone.href} class="link font-semibold">{site.phone.display}</a>
      </p>
    </div>
  </div>
</section>
