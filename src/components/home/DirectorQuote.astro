---
/**
 * A quote from the director, with a portrait. The name and company sit over the photo.
 * Wording, name and role: `director` in src/config/site.ts.
 * PHOTO: replace src/assets/work/aaron.jpg with a real portrait (portrait shape, at least 1200 × 1500).
 */
import { Image } from 'astro:assets';
import { site } from '../../config/site';
import Placeholder from '../ui/Placeholder.astro';
import portrait from '../../assets/work/aaron.jpg';

const { director } = site;
---
<section aria-label={`A word from our ${director.role.toLowerCase()}`} class="border-t border-line py-section">
  <div class="wrap">
    <!-- Photo and caption share one grid cell, so the caption overlaps the bottom of the photo -->
    <figure class="grid gap-y-10 lg:grid-cols-12 lg:gap-x-16">
      <Image
        src={portrait}
        alt="Placeholder: portrait of Aaron Ashton"
        widths={[360, 560, 800]}
        sizes="(min-width: 76rem) 26rem, (min-width: 64rem) 34vw, (min-width: 30rem) 24rem, 100vw"
        class="col-start-1 row-start-1 aspect-[4/5] w-full max-w-sm rounded-md object-cover lg:col-[1/6] lg:max-w-none"
        loading="lazy"
      />
      <blockquote class="col-start-1 row-start-2 self-center border-l-4 border-teal pl-6 md:pl-10 lg:col-[6/13] lg:row-start-1">
        <p class="text-2xl font-medium leading-snug tracking-tight text-navy md:text-[1.875rem] md:leading-[1.3]">
          <Placeholder note="Quote to be approved by Aaron">“{director.quote}”</Placeholder>
        </p>
      </blockquote>
      <figcaption class="col-start-1 row-start-1 mr-auto w-full max-w-sm self-end rounded-b-md bg-navy/90 px-6 py-5 text-white lg:col-[1/6] lg:max-w-none">
        <span class="block text-xl font-bold tracking-tight">{director.name}</span>
        <span class="mt-0.5 block text-paper/90">{director.role}, {site.name}</span>
      </figcaption>
    </figure>
  </div>
</section>
