---
/**
 * Gentle snowfall for the homepage hero over Christmas.
 * Dates and on/off switch: `snow` in src/config/site.ts.
 *
 * Accessibility:
 * - Never runs for people who have asked their device to reduce motion.
 * - A visible button pauses and restarts it (WCAG 2.2.2), and the choice is remembered.
 * - It sits behind the text, is hidden from screen readers and can't be clicked.
 * - It stops when the hero is scrolled out of view or the tab is in the background.
 */
import { site } from '../../config/site';
const { snow } = site;
---
{snow.show && (
  <>
    <canvas
      class="pointer-events-none absolute inset-0 -z-5 h-full w-full"
      aria-hidden="true"
      hidden
      data-snow
      data-from={snow.from}
      data-until={snow.until}
    ></canvas>
    <button
      type="button"
      class="absolute right-4 bottom-4 inline-flex min-h-11 items-center gap-2 rounded-sm border border-paper/40 bg-navy/60 px-3 text-sm font-semibold text-white hover:border-paper/80 sm:right-6 sm:bottom-6"
      hidden
      data-snow-toggle
    >
      <svg class="size-4" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M12 3v18M4.2 7.5l15.6 9M4.2 16.5l15.6-9" />
      </svg>
      <span data-snow-label>Pause snow</span>
    </button>
  </>
)}

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-snow]');
  const button = document.querySelector<HTMLButtonElement>('[data-snow-toggle]');
  const label = button?.querySelector<HTMLElement>('[data-snow-label]');

  // Is today inside the from/until window? Handles a window that crosses New Year.
  const inSeason = (from: string, until: string) => {
    const now = new Date();
    const today = `${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
    return from <= until ? today >= from && today <= until : today >= from || today <= until;
  };

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const ctx = canvas?.getContext('2d');

  if (
    canvas && button && label && ctx &&
    inSeason(canvas.dataset.from ?? '12-01', canvas.dataset.until ?? '01-06') &&
    !reduceMotion.matches
  ) {
    const STORAGE_KEY = 'snow-paused';
    const readPaused = () => {
      try { return localStorage.getItem(STORAGE_KEY) === '1'; } catch { return false; }
    };
    const savePaused = (value: boolean) => {
      try { localStorage.setItem(STORAGE_KEY, value ? '1' : '0'); } catch { /* storage blocked: still works for this visit */ }
    };

    type Flake = { x: number; y: number; r: number; speed: number; drift: number; phase: number; alpha: number };
    let flakes: Flake[] = [];
    let width = 0;
    let height = 0;
    let frame = 0;
    let paused = readPaused();
    let visible = true;

    const makeFlake = (anywhere: boolean): Flake => ({
      x: Math.random() * width,
      y: anywhere ? Math.random() * height : -5,
      r: 0.8 + Math.random() * 2.2,
      speed: 0.25 + Math.random() * 0.7,
      drift: 0.3 + Math.random() * 0.6,
      phase: Math.random() * Math.PI * 2,
      alpha: 0.35 + Math.random() * 0.45,
    });

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = canvas.clientWidth;
      height = canvas.clientHeight;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const count = Math.min(90, Math.round(width / 16));
      flakes = Array.from({ length: count }, () => makeFlake(true));
    };

    const draw = () => {
      ctx.clearRect(0, 0, width, height);
      for (const f of flakes) {
        f.phase += 0.01;
        f.y += f.speed;
        f.x += Math.sin(f.phase) * f.drift * 0.4;
        if (f.y > height + 5) Object.assign(f, makeFlake(false));
        ctx.beginPath();
        ctx.arc(f.x, f.y, f.r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(255, 255, 255, ${f.alpha})`;
        ctx.fill();
      }
    };

    const loop = () => {
      draw();
      frame = requestAnimationFrame(loop);
    };

    const update = () => {
      cancelAnimationFrame(frame);
      const running = !paused && visible && !document.hidden && !reduceMotion.matches;
      canvas.hidden = paused || reduceMotion.matches;
      // The canvas has no size while hidden, so measure it again when it's first shown
      if (!canvas.hidden && canvas.clientWidth !== width) resize();
      if (running) frame = requestAnimationFrame(loop);
      label.textContent = paused ? 'Play snow' : 'Pause snow';
    };

    canvas.hidden = false;
    button.hidden = false;
    resize();
    update();

    button.addEventListener('click', () => {
      paused = !paused;
      savePaused(paused);
      update();
    });

    // Stop when the hero is off screen or the tab is in the background
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      update();
    }).observe(canvas);
    document.addEventListener('visibilitychange', update);
    reduceMotion.addEventListener('change', () => {
      if (reduceMotion.matches) button.hidden = true;
      update();
    });

    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(resize, 200);
    });
  }
</script>
