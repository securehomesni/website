---
/**
 * Bundle offer. Everything here is edited in `bundle` in src/config/site.ts.
 * The button ticks "Security bundle" on the survey form before scrolling to it.
 */
import { site } from '../../config/site';
import Icon from '../ui/Icon.astro';
import Placeholder from '../ui/Placeholder.astro';

const { bundle } = site;
---
{bundle.show && (
  <section aria-labelledby="bundle-title" class="bg-mint py-section">
    <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <h2 id="bundle-title" class="text-3xl tracking-display">Special bundle offer</h2>
        <p class="mt-5 text-lg">CCTV, an intruder alarm and a security light, installed together, for just</p>
        <p class="mt-2 text-[clamp(4rem,2.5rem+6vw,7rem)] font-bold leading-none tracking-display text-navy">
          <Placeholder note="Bundle price">{bundle.price}</Placeholder>
        </p>
        <p class="mt-3 text-muted"><Placeholder note="What the price covers">{bundle.priceNote}</Placeholder></p>

        <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-4">
          <a href="#quote" class="btn btn-primary px-7 text-lg" data-select-interest="Security bundle">Book a survey for the bundle</a>
          <a href={site.phone.href} class="link whitespace-nowrap font-semibold">or call {site.phone.display}</a>
        </div>
      </div>

      <div class="lg:col-span-7">
        <h3 class="text-xl">What’s included in the {bundle.name.toLowerCase()}</h3>
        <ul class="mt-5 border-t-2 border-navy">
          {bundle.includes.map((item) => (
            <li class="grid gap-1 border-b border-navy/15 py-5 sm:grid-cols-[11rem_1fr] sm:gap-6">
              <p class="flex items-center gap-2.5 font-semibold text-navy">
                <Icon name="check" class="text-teal-ink" />{item.title}
              </p>
              <p><Placeholder note="Bundle item details">{item.text}</Placeholder></p>
            </li>
          ))}
        </ul>
        <p class="mt-5 text-sm text-muted">
          Every bundle includes a free survey, a fixed written quote and our standard warranty.
          <Placeholder note="Bundle terms">{bundle.terms}</Placeholder>
        </p>
      </div>
    </div>
  </section>
)}

<script>
  // Tick the matching interest on the survey form, so the request says which offer it's about
  document.querySelectorAll<HTMLAnchorElement>('[data-select-interest]').forEach((link) => {
    link.addEventListener('click', () => {
      const value = link.dataset.selectInterest;
      document
        .querySelectorAll<HTMLInputElement>('input[name="interest"]')
        .forEach((box) => {
          if (box.value === value) box.checked = true;
        });
    });
  });
</script>
