---
/**
 * Hero: navy, full width, with a photo behind a navy overlay.
 * A short headline, one supporting line, the two main actions and trust facts.
 *
 * PHOTO: replace src/assets/work/hero.jpg with a real, wide photo (at least 2400px wide).
 * Choose one where the left side is fairly plain, as the text sits there.
 * Never show a house number, street name or number plate.
 * A still photo is used rather than video: WCAG and the brief rule out autoplaying media.
 */
import { Image } from 'astro:assets';
import { site, ctaLabel, ctaHref } from '../../config/site';
import Icon from '../ui/Icon.astro';
import Placeholder from '../ui/Placeholder.astro';
import Christmas from './Christmas.astro';
import heroPhoto from '../../assets/work/hero.jpg';
---
<section aria-labelledby="hero-title" class="on-dark relative isolate overflow-hidden bg-navy text-paper">
  <Image
    src={heroPhoto}
    alt=""
    widths={[800, 1280, 1920, 2400]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-20 h-full w-full object-cover"
  />
  <!-- Keeps text readable over any photo: solid on small screens, fading to the right on large ones -->
  <div class="absolute inset-0 -z-10 bg-navy/85 lg:bg-transparent lg:bg-linear-to-r lg:from-navy lg:from-40% lg:via-navy/85 lg:to-navy/40" aria-hidden="true"></div>
  <Christmas />

  <div class="wrap flex min-h-[32rem] items-center py-16 md:py-20 lg:min-h-[40rem] lg:py-24">
    <div class="max-w-2xl">
      <h1 id="hero-title" class="max-w-[12ch] text-display font-bold tracking-display text-white">
        Your home, properly protected.
      </h1>
      <p class="mt-6 max-w-xl text-lg text-paper/90">
        CCTV, intruder alarms and security lighting for homes across
        <Placeholder note="Service area summary">{site.areaSummary}</Placeholder>.
        Installed, repaired, upgraded and serviced by our own local, SSAIB-registered engineers.
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:gap-4">
        <a href={site.phone.href} class="btn btn-on-dark px-6 text-lg">
          <Icon name="phone" />
          <span>Call {site.phone.display}</span>
        </a>
        <a href={ctaHref} class="btn border-paper/70 px-6 text-lg text-white hover:bg-white hover:text-navy">{ctaLabel}</a>
      </div>

      <ul class="mt-10 grid gap-x-8 gap-y-3 border-t border-white/15 pt-6 text-paper/90 sm:grid-cols-2" aria-label="Why you can trust us">
        <li class="flex items-center gap-2.5"><Icon name="check" class="text-teal-soft" />
          <span>Local since <Placeholder note="Year established">{site.established}</Placeholder></span>
        </li>
        <li class="flex items-center gap-2.5"><Icon name="check" class="text-teal-soft" />SSAIB registered installer</li>
        <li class="flex items-center gap-2.5"><Icon name="check" class="text-teal-soft" />
          <span>Based in {site.address.locality}</span>
        </li>
        <li class="flex items-center gap-2.5"><Icon name="check" class="text-teal-soft" />
          <span><Placeholder note="Real Google rating and count">Rated {site.reviews.rating} out of 5 on {site.reviews.platform}</Placeholder></span>
        </li>
      </ul>
    </div>
  </div>
</section>
