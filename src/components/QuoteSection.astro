---
/**
 * The booking section: reassurance and contact details beside the form.
 * Used on the homepage and the contact page. Anchor: #quote
 */
import { site } from '../config/site';
import QuoteForm from './forms/QuoteForm.astro';
import Icon from './ui/Icon.astro';

interface Props {
  headingLevel?: 'h1' | 'h2';
}
const { headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
---
<section id="quote" aria-labelledby="quote-title" class="bg-mint py-section">
  <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <Heading id="quote-title" class="text-3xl tracking-display">Book your free home security survey</Heading>
      <p class="mt-5 text-lg">
        Tell us a little about your home and we’ll call to arrange a visit at a time that suits you. There’s no charge and no obligation.
      </p>

      <div class="mt-10 border-t border-navy/20 pt-8">
        <h3 class="text-lg">Rather talk to someone?</h3>
        <ul class="mt-4 space-y-3">
          <li>
            <a href={site.phone.href} class="inline-flex min-h-11 items-center gap-3 text-xl font-bold text-navy hover:text-teal-ink">
              <Icon name="phone" class="text-teal" />
              <span><span class="sr-only">Call </span>{site.phone.display}</span>
            </a>
          </li>
          <li>
            <a href={`mailto:${site.email}`} class="link inline-flex min-h-11 items-center gap-3">
              <Icon name="mail" class="text-teal-ink" />{site.email}
            </a>
          </li>
          <li class="flex gap-3 text-muted">
            <Icon name="clock" class="mt-1 text-teal-ink" />
            <span>
              {site.hours.map((h) => <span class="block">{h.days}: {h.time}</span>)}
            </span>
          </li>
        </ul>
      </div>
    </div>

    <div class="rounded-md border border-line bg-paper p-6 sm:p-8 lg:col-span-7">
      <QuoteForm />
    </div>
  </div>
</section>
