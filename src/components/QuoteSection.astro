---
/**
 * The booking section: reassurance and contact details beside the form. Anchor: #quote
 * The homepage uses tone="dark" as its final call to action; the contact page uses the light version.
 */
import { site } from '../config/site';
import QuoteForm from './forms/QuoteForm.astro';
import Icon from './ui/Icon.astro';

interface Props {
  headingLevel?: 'h1' | 'h2';
  tone?: 'light' | 'dark';
  title?: string;
  intro?: string;
}
const {
  headingLevel = 'h2',
  tone = 'light',
  title = 'Book your free home security survey',
  intro = 'Tell us a little about your home and we’ll call to arrange a visit at a time that suits you. There’s no charge and no obligation.',
} = Astro.props;
const Heading = headingLevel;
const dark = tone === 'dark';
---
<section
  id="quote"
  aria-labelledby="quote-title"
  class:list={['py-section', dark ? 'on-dark bg-navy text-paper' : 'bg-mint']}
>
  <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <Heading id="quote-title" class:list={['text-3xl tracking-display', dark && 'text-white']}>{title}</Heading>
      <p class:list={['mt-5 text-lg', dark && 'text-paper/90']}>{intro}</p>

      {dark && (
        <ul class="mt-8 space-y-2.5 text-paper/90">
          <li class="flex gap-2.5"><Icon name="check" class="mt-1 text-teal-soft" />A fixed written quote, with no pressure to decide</li>
          <li class="flex gap-2.5"><Icon name="check" class="mt-1 text-teal-soft" />Local, SSAIB-registered engineers</li>
          <li class="flex gap-2.5"><Icon name="check" class="mt-1 text-teal-soft" />Takeovers, repairs and servicing for systems we didn’t install</li>
        </ul>
      )}

      <div class:list={['mt-10 border-t pt-8', dark ? 'border-white/15' : 'border-navy/20']}>
        <h3 class:list={['text-lg', dark && 'text-white']}>Rather talk to someone?</h3>
        <ul class="mt-4 space-y-3">
          <li>
            <a
              href={site.phone.href}
              class:list={[
                'inline-flex min-h-11 items-center gap-3 text-xl font-bold',
                dark ? 'text-white hover:text-teal-soft' : 'text-navy hover:text-teal-ink',
              ]}
            >
              <Icon name="phone" class={dark ? 'text-teal-soft' : 'text-teal'} />
              <span><span class="sr-only">Call </span>{site.phone.display}</span>
            </a>
          </li>
          <li>
            <a href={`mailto:${site.email}`} class="link inline-flex min-h-11 items-center gap-3">
              <Icon name="mail" />{site.email}
            </a>
          </li>
          <li class:list={['flex gap-3', dark ? 'text-paper/85' : 'text-muted']}>
            <Icon name="clock" class={`mt-1 ${dark ? 'text-teal-soft' : 'text-teal-ink'}`} />
            <span>
              {site.hours.map((h) => <span class="block">{h.days}: {h.time}</span>)}
            </span>
          </li>
        </ul>
      </div>
    </div>

    <!-- The form always sits on a light panel, so its colours and focus styles stay the same -->
    <div class="on-light rounded-md border border-line bg-paper p-6 text-ink sm:p-8 lg:col-span-7">
      <QuoteForm />
    </div>
  </div>
</section>
