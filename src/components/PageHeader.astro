---
/**
 * Top of every inner page: breadcrumbs, the page's single h1 and an intro.
 * Optional slot for actions (e.g. CTA buttons).
 */
interface Props {
  title: string;
  intro?: string;
  breadcrumbs?: { name: string; path: string }[];
}
const { title, intro, breadcrumbs = [] } = Astro.props;
---
<div class="border-b border-line">
  <div class="wrap py-12 md:py-16">
    {breadcrumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="mb-6 text-sm">
        <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-muted">
          {breadcrumbs.map((crumb, i) => (
            <li class="inline-flex items-center gap-2">
              {i < breadcrumbs.length - 1 ? (
                <>
                  <a class="link inline-flex min-h-6 items-center" href={crumb.path}>{crumb.name}</a>
                  <span aria-hidden="true">/</span>
                </>
              ) : (
                <span aria-current="page">{crumb.name}</span>
              )}
            </li>
          ))}
        </ol>
      </nav>
    )}
    <h1 class="max-w-3xl text-3xl tracking-display md:text-[3.25rem] md:leading-[1.04]">{title}</h1>
    {intro && <p class="mt-5 max-w-2xl text-lg">{intro}</p>}
    {Astro.slots.has('default') && <div class="mt-8"><slot /></div>}
  </div>
</div>
