---
/**
 * Hero for inner pages, laid out like a service landing page:
 * breadcrumb, photo, Google rating, headline, three short points, then Call and Request a call back.
 * On phones the photo comes first; on wider screens it sits on the right.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site, ctaLabel, ctaHref } from '../config/site';
import GoogleRating from './GoogleRating.astro';
import Icon from './ui/Icon.astro';

interface Props {
  title: string;
  points: string[];
  image: ImageMetadata;
  imageAlt: string;
  breadcrumbs: { name: string; path: string }[];
}
const { title, points, image, imageAlt, breadcrumbs } = Astro.props;
---
<section aria-labelledby="page-hero-title" class="on-dark bg-navy text-paper">
  <div class="wrap pt-6 pb-12 lg:pt-8 lg:pb-16">
    <nav aria-label="Breadcrumb" class="text-sm">
      <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-paper/85">
        {breadcrumbs.map((crumb, i) => (
          <li class="inline-flex items-center gap-2">
            {i < breadcrumbs.length - 1 ? (
              <>
                <a class="link inline-flex min-h-6 items-center" href={crumb.path}>{crumb.name}</a>
                <span aria-hidden="true">/</span>
              </>
            ) : (
              <span aria-current="page">{crumb.name}</span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <div class="mt-6 grid gap-8 lg:mt-8 lg:grid-cols-12 lg:items-center lg:gap-12">
      <div class="lg:col-span-6">
        <GoogleRating tone="dark" />
        <h1 id="page-hero-title" class="mt-4 text-3xl tracking-display text-white md:text-[3.25rem] md:leading-[1.04]">{title}</h1>
        <ul class="mt-6 space-y-3 text-lg text-paper/90">
          {points.map((point) => (
            <li class="flex gap-3"><Icon name="check" class="mt-1.5 text-teal-soft" />{point}</li>
          ))}
        </ul>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:gap-4">
          <a href={site.phone.href} class="btn btn-on-dark px-6 text-lg">
            <Icon name="phone" />
            <span>Call {site.phone.display}</span>
          </a>
          <a href={ctaHref} class="btn border-paper/70 px-6 text-lg text-white hover:bg-white hover:text-navy">{ctaLabel}</a>
        </div>
      </div>

      <div class="order-first lg:order-none lg:col-span-6">
        <Image
          src={image}
          alt={imageAlt}
          widths={[480, 800, 1200, 1600]}
          sizes="(min-width: 76rem) 35rem, (min-width: 64rem) 46vw, 100vw"
          loading="eager"
          fetchpriority="high"
          class="aspect-[16/10] w-full rounded-md object-cover lg:aspect-[4/3]"
        />
      </div>
    </div>
  </div>
</section>
